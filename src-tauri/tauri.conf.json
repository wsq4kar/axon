{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axon",
  "version": "0.1.0",
  "identifier": "io.github.wsq4kar.axon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Axon",
        "width": 1180,
        "height": 740,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Axon contributors",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Open-source VPN client",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "binaries/": "binaries/" },
    "windows": {
      "nsis": { "languages": ["Russian", "English"], "displayLanguageSelector": false }
    }
  }
}
